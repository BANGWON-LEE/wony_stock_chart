{
  "fontFamily": {
    "sans": { "$type": "fontFamily", "$value": "system-ui, 'Segoe UI', Roboto, sans-serif" },
    "heading": { "$type": "fontFamily", "$value": "system-ui, 'Segoe UI', Roboto, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "ui-monospace, Consolas, monospace" }
  },
  "fontSize": {
    "xs": { "$type": "dimension", "$value": "12px" },
    "sm": { "$type": "dimension", "$value": "14px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "18px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "2xl": { "$type": "dimension", "$value": "24px" },
    "4xl": { "$type": "dimension", "$value": "36px" },
    "6xl": { "$type": "dimension", "$value": "56px" }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.18 },
    "normal": { "$type": "number", "$value": 1.45 },
    "relaxed": { "$type": "number", "$value": 1.6 }
  },
  "letterSpacing": {
    "tight": { "$type": "dimension", "$value": "-0.03em" },
    "normal": { "$type": "dimension", "$value": "0em" },
    "wide": { "$type": "dimension", "$value": "0.01em" }
  }
}
