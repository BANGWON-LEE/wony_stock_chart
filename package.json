{
  "name": "chart",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --filter @chart/backend dev",
    "build": "pnpm --dir frontend build",
    "build:backend": "pnpm --filter @chart/backend build",
    "lint": "pnpm --dir frontend lint",
    "lint:backend": "pnpm --filter @chart/backend lint",
    "typecheck:backend": "pnpm --filter @chart/backend typecheck"
  }
}
